{
	"name": "bh2980_blog",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"cms:db:migrate": "cms migrate",
		"build": "rm -rf .next && next build",
		"preview": "pnpm build && pnpm start",
		"start": "next start",
		"test": "vitest",
		"test:run": "vitest run",
		"lint": "pnpm exec biome check .",
		"lint:fix": "pnpm exec biome check . --write",
		"check:korean": "node scripts/check-korean.mjs",
		"typecheck": "pnpm exec tsc --noEmit && pnpm --filter @bh2980/cms typecheck && pnpm --filter @bh2980/cms-admin typecheck && pnpm --filter @bh2980/cms-blocks typecheck && pnpm --filter @bh2980/cms-ai typecheck && pnpm --filter @bh2980/cms-text-check typecheck && pnpm --filter @bh2980/cms-seo typecheck",
		"prepare": "husky",
		"build:packages": "pnpm --filter @bh2980/cms build && pnpm --filter @bh2980/cms-admin build && pnpm --filter @bh2980/cms-ai build && pnpm --filter @bh2980/cms-blocks build && pnpm --filter @bh2980/cms-text-check build && pnpm --filter @bh2980/cms-seo build",
		"example:check": "node scripts/check-example.mjs",
		"example:pack": "pnpm build:packages && mkdir -p examples/other-site/vendor && for p in cms cms-admin cms-blocks cms-ai cms-text-check cms-seo; do pnpm --dir packages/$p pack --pack-destination ../../examples/other-site/vendor; done"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@bh2980/cms": "workspace:*",
		"@bh2980/cms-admin": "workspace:*",
		"@bh2980/cms-ai": "workspace:*",
		"@bh2980/cms-blocks": "workspace:*",
		"@bh2980/cms-seo": "workspace:*",
		"@bh2980/cms-text-check": "workspace:*",
		"@shikijs/langs": "^3.21.0",
		"@shikijs/themes": "^3.21.0",
		"@shikijs/transformers": "^3.22.0",
		"@tanstack/react-query": "^5.104.0",
		"@tiptap/core": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/react": "^3.31.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"feed": "^5.2.0",
		"hast-util-to-string": "^3.0.1",
		"katex": "^0.16.45",
		"lucide-react": "^0.562.0",
		"mermaid": "^11.12.2",
		"next": "16.3.8",
		"next-auth": "5.0.0-beta.32",
		"next-mdx-remote": "^6.0.0",
		"next-themes": "^0.4.6",
		"nuqs": "^2.8.6",
		"pg": "^8.23.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"recharts": "^3.8.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-breaks": "^4.0.0",
		"remark-directive": "^4.0.0",
		"remark-flexible-toc": "^1.2.4",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"server-only": "^0.0.1",
		"shiki": "^3.21.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.4.0",
		"unist-util-visit": "^5.0.0",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@tailwindcss/postcss": "^4",
		"@tailwindcss/typography": "^0.5.16",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "^20",
		"@types/pg": "^8.23.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"husky": "^9.1.7",
		"jsdom": "^27.4.0",
		"lint-staged": "^17.6.0",
		"mdast-util-from-markdown": "^2.0.2",
		"mdast-util-mdx-jsx": "^3.2.0",
		"tailwindcss": "^4",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"unified": "^11.0.5",
		"vite": "^8.3.0",
		"vitest": "^4.0.18"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
