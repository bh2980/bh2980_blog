{
	"name": "@bh2980/cms-text-check",
	"version": "0.0.0",
	"private": true,
	"cmsPlugin": true,
	"description": "@bh2980/cms의 맞춤법·문장 검사 확장 틀(검사기 정의·편집기 확장·서버 경로)과 검사기 모음: 바른(Bareun)",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./extension": "./src/extension.tsx",
		"./server": "./src/server.ts",
		"./bareun": "./src/bareun/index.ts",
		"./bareun/server": {
			"browser": "./src/bareun/server.browser.ts",
			"default": "./src/bareun/server.ts"
		},
		"./bareun/admin": "./src/bareun/admin.ts",
		"./styles.css": "./styles.css"
	},
	"scripts": {
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit -p .",
		"build": "node ../../scripts/build-package.mjs"
	},
	"peerDependencies": {
		"@bh2980/cms": "workspace:^",
		"@bh2980/cms-admin": "workspace:^",
		"@tiptap/core": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/react": "^3.31.3",
		"lucide-react": ">=0.562.0",
		"next": ">=16",
		"react": ">=19",
		"sonner": "^2.0.8"
	},
	"devDependencies": {
		"@bh2980/cms": "workspace:*",
		"@bh2980/cms-admin": "workspace:*",
		"@tanstack/react-query": "^5.104.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@tiptap/core": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/react": "^3.31.3",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"jsdom": "^27.4.0",
		"lucide-react": "^0.562.0",
		"next": "16.3.8",
		"next-auth": "5.0.0-beta.32",
		"next-themes": "^0.4.6",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"sonner": "^2.0.8",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^4.0.18"
	},
	"files": [
		"dist",
		"README.md",
		"styles.css"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./extension": {
				"types": "./dist/extension.d.ts",
				"default": "./dist/extension.js"
			},
			"./server": {
				"types": "./dist/server.d.ts",
				"default": "./dist/server.js"
			},
			"./bareun": {
				"types": "./dist/bareun/index.d.ts",
				"default": "./dist/bareun/index.js"
			},
			"./bareun/server": {
				"types": "./dist/bareun/server.d.ts",
				"browser": "./dist/bareun/server.browser.js",
				"default": "./dist/bareun/server.js"
			},
			"./bareun/admin": {
				"types": "./dist/bareun/admin.d.ts",
				"default": "./dist/bareun/admin.js"
			},
			"./styles.css": "./styles.css"
		}
	}
}
